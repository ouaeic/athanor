[Unit]
Description=Record a failed athanor backup
# Started by OnFailure= on the backup unit, never on its own.
RefuseManualStart=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/athanor backup auto alert
# The journal is the one place a failure is already being written, so it is written at the level
# that shows up in `journalctl -p err` rather than buried among informational lines.
SyslogIdentifier=athanor-backup
SyslogLevel=err

[Unit]
Description=Weekly athanor unattended update

[Timer]
# Off until the operator runs `athanor auto-update on`. The random delay keeps every
# athanor installation from pulling from the same origin at the same minute.
OnCalendar=weekly
RandomizedDelaySec=6h
AccuracySec=1h
Persistent=true
Unit=athanor-auto-update.service

[Install]
WantedBy=timers.target

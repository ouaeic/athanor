{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athanor",
  "version": "0.1.0",
  "identifier": "org.athanor.ai",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "athanor",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Private open-source AI cloud computer",
    "longDescription": "A secure native companion for your athanor remote computer.",
    "copyright": "athanor contributors",
    "iOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.ios.plist"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["athanor"]
      },
      "mobile": [
        {
          "scheme": ["athanor"],
          "appLink": false
        }
      ]
    }
  }
}

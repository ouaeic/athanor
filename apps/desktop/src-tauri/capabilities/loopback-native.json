{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-native",
  "description": "Native permissions scoped at runtime to the bound garden main origin",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": []
  },
  "permissions": [
    "allow-native-capabilities",
    "allow-open-authorization-browser",
    "allow-open-preview-browser",
    "allow-choose-folder",
    "allow-revoke-folder",
    "allow-list-local-folder",
    "allow-read-local-file"
  ]
}

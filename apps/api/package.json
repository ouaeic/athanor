{
  "name": "@athanor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/websocket": "11.3.0",
    "@athanor/contracts": "workspace:*",
    "@athanor/core": "workspace:*",
    "@athanor/data": "workspace:*",
    "@athanor/model-gateway": "workspace:*",
    "@athanor/relay-client": "workspace:*",
    "@athanor/worker": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "fastify": "5.10.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}

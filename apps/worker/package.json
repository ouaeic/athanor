{
  "name": "@athanor/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/agent.ts",
      "development": "./src/agent.ts",
      "default": "./dist/agent.js"
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--conditions=development --env-file-if-exists=../../.env\" tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@athanor/contracts": "workspace:*",
    "@athanor/core": "workspace:*",
    "@athanor/data": "workspace:*",
    "@athanor/model-gateway": "workspace:*",
    "zod": "4.4.3"
  }
}

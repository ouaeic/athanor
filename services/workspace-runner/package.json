{
  "name": "@athanor/workspace-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/websocket": "11.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1",
    "@athanor/contracts": "workspace:*",
    "@athanor/core": "workspace:*",
    "fastify": "5.12.1",
    "playwright-core": "1.62.1",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}

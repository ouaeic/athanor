{
  "name": "@athanor/relay-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run --exclude 'dist/**' && NODE_OPTIONS=--conditions=development tsx scripts/relay-roundtrip.mts"
  },
  "dependencies": {
    "@athanor/relay": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.21.0"
  }
}

{
  "name": "athanor-ai-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @athanor/api --filter @athanor/web --filter @athanor/workspace-runner dev",
    "dev:postgres": "pnpm --parallel --filter @athanor/api --filter @athanor/web --filter @athanor/worker --filter @athanor/workspace-runner dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/check-dependency-licenses.mjs",
    "license:rust": "node scripts/check-rust-licenses.mjs",
    "release:check": "node scripts/check-release.mjs",
    "check": "pnpm license:check && node scripts/check-repository.mjs && node scripts/test-document.mjs && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "native:configure": "node apps/desktop/configure-native.mjs",
    "desktop:dev": "pnpm --filter @athanor/desktop dev",
    "desktop:build": "pnpm --filter @athanor/desktop native:build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.4",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vitest": "4.0.18"
  }
}

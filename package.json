{
  "name": "athanor-ai-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @athanor/api --filter @athanor/web --filter @athanor/workspace-runner dev",
    "dev:postgres": "pnpm --parallel --filter @athanor/api --filter @athanor/web --filter @athanor/worker --filter @athanor/workspace-runner dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p evals/tsconfig.json --noEmit",
    "test": "pnpm -r test",
    "eval": "NODE_OPTIONS=--conditions=development tsx evals/run.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/check-dependency-licenses.mjs",
    "license:rust": "node scripts/check-rust-licenses.mjs",
    "release:check": "node scripts/check-release.mjs",
    "check": "pnpm license:check && pnpm release:check && node scripts/check-repository.mjs && node scripts/test-document.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "native:configure": "node apps/desktop/configure-native.mjs",
    "desktop:dev": "pnpm --filter @athanor/desktop dev",
    "desktop:build": "pnpm --filter @athanor/desktop native:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
